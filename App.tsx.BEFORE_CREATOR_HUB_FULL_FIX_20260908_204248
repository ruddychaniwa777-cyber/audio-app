      icon: "⌕",
      label: "Discover",
    },
    {
      id: "messages",
      icon: "◌",
      label: "Messages",
    },
    {
      id: "rewards",
      icon: "◆",
      label: "Rewards",
    },
    {
      id: "profile",
      icon: "●",
      label: "Profile",
    },
  ];

  return (
    <View style={styles.bottomNav}>
      {items.map(item => {
        const selected =
          active === item.id;

        return (
          <Pressable
            key={item.id}
            style={styles.navItem}
            onPress={() =>
              onChange(item.id)
            }
          >
            <Text
              style={[
