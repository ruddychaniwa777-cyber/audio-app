   ============================================================ */

const API_BASE = "http://16.170.245.45:3000";

const STORAGE = {
  USER: "@pocket_rivals_user_v2",
  TOKEN: "@pocket_rivals_token_v2",
  LIKES: "@pocket_rivals_likes_v2",
  FOLLOWS: "@pocket_rivals_follows_v2",
