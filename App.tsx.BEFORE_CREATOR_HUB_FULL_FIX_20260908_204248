              </Text>
            </Pressable>
          </View>

          {packages.map(item => (
            <TouchableOpacity
              key={item.coins}
              style={styles.coinPackage}
              onPress={() =>
                onBuy(item.coins)
              }
            >
              <Text style={styles.packageCoins}>
